# OpenAI APIキー (WebRTC接続のエフェメラルトークン取得にも使用)
OPENAI_API_KEY=sk-...

# TickTick OAuth認証情報
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://localhost:8080/callback
TICKTICK_USERNAME=
TICKTICK_PASSWORD=

# トークン保存先ファイルパス
TOKEN_FILE=.tokens.json

# 起動モード: "wakeword"(音声起動) または "pushtotalk"(キー押下起動)
ACTIVATION_MODE=wakeword

# ウェイクワード検出の感度 (0.0〜1.0, 低いほど反応しやすい)
WAKEWORD_SENSITIVITY=0.5

# Push-to-talkのホットキー (PC用)
PTT_HOTKEY=ctrl+space

# 定時Nudgeの時間帯 (JST, 毎時0分に通知)
NUDGE_START_HOUR=7
NUDGE_END_HOUR=23

# AIの声色 (alloy, ash, ballad, coral, echo, sage, shimmer, verse)
OPENAI_VOICE=alloy

# 会話の無音タイムアウト秒数 (この時間黙ったら会話終了)
SESSION_IDLE_TIMEOUT=10

# 音声区間検出 (Voice Activity Detection)
# THRESHOLD: 音声と判定する閾値 (0.0〜1.0, 高いほどノイズを弾く)
VAD_THRESHOLD=0.5
# PREFIX_PADDING_MS: 発話開始前に取り込むバッファ (ミリ秒)
VAD_PREFIX_PADDING_MS=300
# SILENCE_DURATION_MS: この時間黙ったら発話終了と判定 (ミリ秒)
VAD_SILENCE_DURATION_MS=500

# 音声前処理 (各機能を true/false で切り替え)
# ノイズゲート: 閾値以下の小さな音を無音化してノイズを除去
AUDIO_NOISE_GATE=true
# ノイズゲートの閾値 (0.0〜1.0, 高いほど強くカット)
AUDIO_NOISE_GATE_THRESHOLD=0.015
# AGC (自動音量調整): 音量を一定レベルに正規化
AUDIO_AGC=true
# AGCの目標RMS値 (0.0〜1.0)
AUDIO_AGC_TARGET_RMS=0.1
# AGCの最大増幅倍率 (小さい音を増幅しすぎないための上限)
AUDIO_AGC_MAX_GAIN=5.0
# ダイナミックレンジ圧縮: 大きい音を抑えて音量差を均す
AUDIO_COMPRESSOR=true
# 圧縮が始まる閾値 (0.0〜1.0, これを超えた音を圧縮)
AUDIO_COMPRESSOR_THRESHOLD=0.3
# 圧縮比率 (4.0 = 閾値を超えた部分を1/4に圧縮)
AUDIO_COMPRESSOR_RATIO=4.0

# エコー検出 (AI音声のマイク回り込みを相互相関で検出し抑制)
ECHO_DETECT_ENABLED=true
# 相関閾値 (0.0〜1.0, 高いほど厳密にエコー判定)
ECHO_DETECT_THRESHOLD=0.6
# 参照バッファ長 (秒, 再生音の保持期間)
ECHO_DETECT_BUFFER_SEC=1.0
# エコー検出時の減衰量 (dB, 負の値)
ECHO_DETECT_SUPPRESSION_DB=-30

# ログレベル (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
