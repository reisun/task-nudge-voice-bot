# OpenAI
OPENAI_API_KEY=sk-...

# TickTick OAuth
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://localhost:8080/callback
TICKTICK_USERNAME=
TICKTICK_PASSWORD=

# Token persistence
TOKEN_FILE=.tokens.json

# Activation mode: "wakeword" or "pushtotalk"
ACTIVATION_MODE=wakeword

# Wake word sensitivity (0.0 - 1.0)
WAKEWORD_SENSITIVITY=0.5

# Push-to-talk hotkey (for PC mode)
PTT_HOTKEY=ctrl+space

# Nudge schedule: cron-style hour range (JST)
NUDGE_START_HOUR=7
NUDGE_END_HOUR=23

# OpenAI Realtime voice
OPENAI_VOICE=alloy

# Session idle timeout in seconds (auto-end conversation after silence)
SESSION_IDLE_TIMEOUT=10

# Voice Activity Detection (turn detection)
VAD_THRESHOLD=0.5
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_DURATION_MS=500

# Audio preprocessing (each can be true/false)
AUDIO_NOISE_GATE=true
AUDIO_NOISE_GATE_THRESHOLD=0.015
AUDIO_AGC=true
AUDIO_AGC_TARGET_RMS=0.1
AUDIO_AGC_MAX_GAIN=5.0
AUDIO_COMPRESSOR=true
AUDIO_COMPRESSOR_THRESHOLD=0.3
AUDIO_COMPRESSOR_RATIO=4.0

# Log level
LOG_LEVEL=INFO
