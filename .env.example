# OpenAI
OPENAI_API_KEY=sk-...

# TickTick OAuth
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://localhost:8080/callback
TICKTICK_USERNAME=
TICKTICK_PASSWORD=

# Token persistence
TOKEN_FILE=.tokens.json

# Activation mode: "wakeword" or "pushtotalk"
ACTIVATION_MODE=wakeword

# Wake word sensitivity (0.0 - 1.0)
WAKEWORD_SENSITIVITY=0.5

# Push-to-talk hotkey (for PC mode)
PTT_HOTKEY=ctrl+space

# Nudge schedule: cron-style hour range (JST)
NUDGE_START_HOUR=7
NUDGE_END_HOUR=23

# OpenAI Realtime voice
OPENAI_VOICE=alloy

# Session idle timeout in seconds (auto-end conversation after silence)
SESSION_IDLE_TIMEOUT=60

# Voice Activity Detection (turn detection)
VAD_THRESHOLD=0.8
VAD_PREFIX_PADDING_MS=200
VAD_SILENCE_DURATION_MS=300

# Log level
LOG_LEVEL=INFO
